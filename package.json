{
  "name": "car-garage-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "2D top-down car garage simulator prototype (manual driving, trajectory, clearance readout)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && esbuild scripts/verify.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify.mjs --log-level=warning && node node_modules/.cache/verify.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vite": "^7.0.0"
  }
}
